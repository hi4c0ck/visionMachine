{
  "name": "visionmachine-desktop",
  "version": "0.7.1",
  "description": "AI-powered video generation tool with professional composer interface",
  "author": "hi4c0ck",
  "license": "MIT",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "sync:meta": "node scripts/sync-meta.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "build:desktop": "node scripts/build/runner.mjs",
    "build:desktop:light": "node scripts/build/runner.mjs --light",
    "build:desktop:full": "node scripts/build/runner.mjs --light --features bundled-ffmpeg",
    "build:status": "node scripts/build/ctl.mjs status",
    "build:watch": "node scripts/build/ctl.mjs watch",
    "build:stop": "node scripts/build/ctl.mjs stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.7.2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-log": "^2.9.0",
    "@tauri-apps/plugin-shell": "^2.3.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@sveltejs/vite-plugin-svelte": "^6.1.0",
    "@tauri-apps/cli": "^2.7.2",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^22.15.30",
    "@vitest/ui": "^3.2.4",
    "jsdom": "^26.1.0",
    "svelte": "^5.32.2",
    "svelte-check": "^4.2.2",
    "typescript": "~5.8.2",
    "vite": "^8.2.2",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
