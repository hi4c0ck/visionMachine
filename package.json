{
  "name": "visionmachine-desktop",
  "version": "0.7.5",
  "description": "AI-powered video generation tool with professional composer interface",
  "author": "@HorizonesMachines <horizonsmachine@gmail.com>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hi4c0ck/visionMachine.git"
  },
  "homepage": "https://github.com/hi4c0ck/visionMachine",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "sync:meta": "node scripts/sync-meta.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --tsgo",
    "tauri": "tauri",
    "build:desktop": "node scripts/build/runner.mjs",
    "build:desktop:light": "node scripts/build/runner.mjs --light",
    "build:desktop:full": "node scripts/build/runner.mjs --light --features bundled-ffmpeg",
    "build:status": "node scripts/build/ctl.mjs status",
    "build:watch": "node scripts/build/ctl.mjs watch",
    "build:stop": "node scripts/build/ctl.mjs stop",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-shell": "^2.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/svelte": "^5.2.8",
    "@types/node": "^26.6.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/ui": "^5.0.3",
    "jsdom": "^30.1.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "type": "module"
}
