# VisionMachine Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit your actual .env file!

# Required: Master password for encrypting API keys
# Use a strong, unique password (minimum 16 characters)
VISION_MACHINE_PASSWORD=your-master-password-here

# Optional: Custom Python path (usually not needed)
PYTHON_PATH=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Optional: Provider configuration (via UI, not environment)
# API keys are stored encrypted in database, not here

# Notes:
# - Do NOT put actual API keys in this file
# - API keys are managed through the app's Settings panel
# - Master password is required to decrypt stored keys
# - Keep .env file secure and never commit it
