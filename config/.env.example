# VisionMachine Environment Variables (Example)

# SECURITY: Do NOT commit this file with real values!
# Copy to .env and fill in your actual values.

# Master password for API key encryption (REQUIRED)
VISION_MACHINE_PASSWORD=change-this-to-a-secure-password

# Optional: Python executable path (usually auto-detected)
# PYTHON_PATH=

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Note: API keys are managed through the app Settings panel, not here.
# The .env file only contains the master password for decrypting stored keys.
