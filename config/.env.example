# VisionMachine Environment Variables (Example)
# Copy this file to .env and fill in YOUR actual values

# Master password for encrypting API keys (REQUIRED)
# Use a STRONG, UNIQUE password (minimum 16 characters)
# This is NEVER stored in the repository
VISION_MACHINE_PASSWORD=YOUR_SECURE_PASSWORD_HERE

# Optional: Custom Python path (usually auto-detected)
# PYTHON_PATH=C:\Python312\python.exe

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# IMPORTANT SECURITY NOTES:
# 1. NEVER put your actual VISION_MACHINE_PASSWORD in this file and commit it
# 2. NEVER put API keys here - they are managed through the app's Settings panel
# 3. This .env.example file is SAFE to commit (no real secrets)
# 4. Create a local .env file from this template with YOUR actual values
# 5. The .env file is gitignored and should never be committed
