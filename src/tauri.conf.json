{
  "build": {
    "frontendDist": "../src/frontend",
    "devUrl": "http://localhost:5173"
  },
  "package": {
    "productName": "VisionMachine",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.visionmachine.app",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/icon.ico"
      ]
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "VisionMachine",
        "width": 1200
      }
    ]
  }
}
