{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "FilmSeed",
  "title": "FilmSeed",
  "description": "Minimal entry config (input to Node A).",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "idea", "genre", "ratio", "scale"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "idea":  { "type": "string", "minLength": 10 },
    "input_text": { "type": "string", "description": "Optional verbatim user text (display-only for the human report; the LLM reads `idea`)." },
    "genre": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "style"],
      "properties": {
        "name":  { "type": "string" },
        "style": { "type": "string" }
      }
    },
    "ratio": { "enum": ["16:9", "9:16", "1:1"] },
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenes", "shotsPerScene", "clipS"],
      "properties": {
        "scenes":        { "type": "integer", "minimum": 1, "maximum": 24 },
        "shotsPerScene": { "type": "integer", "minimum": 1, "maximum": 5 },
        "clipS": {
          "type": "array",
          "items": { "type": "integer", "minimum": 4, "maximum": 12 },
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
